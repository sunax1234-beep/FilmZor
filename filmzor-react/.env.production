# Produkčný build (npm run build / Cloudflare Pages) posiela API requesty
# na rovnakú doménu ako appka (Pages Function functions/api/[[path]].js
# ich proxuje na Fly backend) — rieši to blokovanie cross-site session
# cookie modernými prehliadačmi. Vite tento súbor prepíše cez .env len
# pre "production" mode, "npm run dev" naďalej používa VITE_WEBSHARE_API_URL
# z .env (priame LAN/localhost pripojenie na backend).
VITE_WEBSHARE_API_URL=
