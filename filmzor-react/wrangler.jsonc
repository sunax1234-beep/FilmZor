{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filmzor-react",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
