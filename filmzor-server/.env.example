# Skopíruj tento súbor ako .env a uprav hodnoty.

PORT=4000

# Ľubovoľný náhodný reťazec na podpisovanie session cookie (napr. `openssl rand -hex 32`).
SESSION_SECRET=zmen-ma-na-nahodny-retazec

# Origin frontendu, ktorý smie volať toto API (Vite dev server).
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
